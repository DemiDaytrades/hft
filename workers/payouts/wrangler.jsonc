{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hft-payouts",
  "account_id": "780fda88bb137eedefd9d3981a8816b4",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Daily sweep of affiliate commissions past their hold window.
  "triggers": {
    "crons": ["0 9 * * *"]
  },

  // Same database as the main app -- this Worker only reads settings and
  // updates commission rows.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hft-data",
      "database_id": "baec727f-4a9a-4915-81e2-d549c5095fb5"
    }
  ],

  "observability": {
    "enabled": true
  }
}
