{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hft-landing",
  "account_id": "780fda88bb137eedefd9d3981a8816b4",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: required by both OpenNext and Better Auth (AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hft-data",
      "database_id": "baec727f-4a9a-4915-81e2-d549c5095fb5",
      "migrations_dir": "./migrations"
    }
  ],

  "services": [{"binding":"CLASSROOM_HUB","service":"hft-classroom-control"}],

  "observability": {
    "enabled": true
  },

  "vars": {
    "EMAIL_FROM": "High Frequency Talent <noreply@highfrequency.vip>",
    "BETTER_AUTH_URL": "https://highfrequency.vip"
  }
,
  "r2_buckets": [
    {
      "binding": "ACADEMY_BUCKET",
      "bucket_name": "hft-academy-uploads"
    }
  ]
}
