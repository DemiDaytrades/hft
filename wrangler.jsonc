{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hft-landing",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // nodejs_compat: required by both OpenNext and Better Auth (AsyncLocalStorage).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hft-data",
      "database_id": "baec727f-4a9a-4915-81e2-d549c5095fb5",
      "migrations_dir": "./migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
