# Community links used in the nav, community section and footer.
# These already default to the real invites in lib/site.ts — only set these to
# override without a code change.
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/your-channel

# NOTE: there is deliberately no Stripe Payment Link variable here any more.
# Checkout runs through /join so that referrals are credited, the account is
# created and the Stripe customer is linked. Pointing the CTAs at a raw Payment
# Link would skip all of that.
#
# Stripe is configured by the owner in the admin UI (Settings → Payments),
# not through env vars. Server secrets live in .dev.vars / wrangler secret:
#   BETTER_AUTH_SECRET, SETTINGS_ENCRYPTION_KEY
